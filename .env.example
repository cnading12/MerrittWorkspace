# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_SNACKSHOP=

# Public site URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Signing secret for the onboarding cancel-token links emailed to applicants
# (lib/portal/cancelToken.ts). Falls back to SUPABASE_SERVICE_ROLE_KEY when
# unset, so it is optional — but set it explicitly if you ever rotate the
# service role key, or every outstanding cancel link breaks at once.
PORTAL_CANCEL_TOKEN_SECRET=

# Vercel Cron shared secret. Vercel sends it as `Authorization: Bearer <value>`
# on every scheduled run (see vercel.json). Required by
# /api/cron/supabase-keep-alive, which refuses to run without it.
CRON_SECRET=

# Google Calendar service account (manager@merrittworkspace.net)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Conference room calendar (existing)
GOOGLE_CALENDAR_ID=

# Flex space booking calendars
# Wellness calendar shared with the workspace service account. Coworking flex
# reservations are now created directly ON this calendar (so wellness and
# coworking bookings share one source of truth and can't double-book), so the
# service account must have "Make changes to events" (write) access here — NOT
# just read-only. Get the ID from the Wellness calendar's settings page.
WELLNESS_CALENDAR_ID=
# Legacy Flex Space Bookings calendar under manager@merrittworkspace.net. No
# longer written to; still consulted for conflicts so reservations created on
# it before the cutover keep blocking overlapping times.
FLEX_CALENDAR_ID=c_9e233eb9e5c304f2ee32bafbceba61a96a4c0a54cf5dabc7c9f4e053e0527072@group.calendar.google.com
